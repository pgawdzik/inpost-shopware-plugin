{
    "name": "clueware/inpost-shipping",
    "description": "Free InPost Shopware plugin for Shopware 6: parcel lockers, courier shipping, PDF labels and tracking via ShipX.",
    "version": "2.0.16",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "homepage": "https://github.com/pgawdzik/inpost-shopware-plugin",
    "keywords": ["shopware", "shopware6", "inpost", "shipping", "parcel-locker", "shipx"],
    "support": {
        "issues": "https://github.com/pgawdzik/inpost-shopware-plugin/issues",
        "source": "https://github.com/pgawdzik/inpost-shopware-plugin"
    },
    "authors": [
        {
            "name": "Clueware",
            "role": "Manufacturer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": ">=6.7.0.0 <=6.7.16.0",
        "shopware/storefront": ">=6.7.0.0 <=6.7.16.0"
    },
    "autoload": {
        "psr-4": {
            "Clueware\\InpostShipping\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Clueware\\InpostShipping\\CluewareInpostShipping",
        "label": {
            "de-DE": "InPost Versand",
            "en-GB": "InPost Shipping",
            "pl-PL": "Wysyłka InPost"
        },
        "description": {
            "de-DE": "Integriert InPost-Paketautomaten und Kurierdienste mit Abholpunktauswahl im Checkout sowie Sendungsverwaltung, Sendungsverfolgung und Etikettendownload in der Administration.",
            "en-GB": "Integrate InPost parcel locker and courier shipping with pickup point selection at checkout, shipment management, tracking and label downloads directly in Administration.",
            "pl-PL": "Wybór Paczkomatu i kompletna obsługa pojedynczych przesyłek InPost."
        },
        "manufacturerLink": {
            "de-DE": "https://clueware.de",
            "en-GB": "https://clueware.de",
            "pl-PL": "https://clueware.de"
        },
        "supportLink": {
            "de-DE": "https://clueware.de",
            "en-GB": "https://clueware.de",
            "pl-PL": "https://clueware.de"
        }
    },
    "config": {
        "sort-packages": true
    }
}
